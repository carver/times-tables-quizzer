rules_version = '2';

// Access model (see docs/adr/0006): the document ID itself, a 122-bit
// random Profile ID handed out only via a pairing link/QR, is the real
// access boundary, the same trust model as an unlisted document link.
// `isSignedIn()` is a cheap anonymous-auth speed bump against drive-by
// bots, not the security boundary; it deliberately does NOT check who
// the signed-in user is, since any device holding the right link is
// meant to read/write it.
//
// No `list` is ever granted on `/profiles`. Default-deny already
// covers this (there is no `allow list` below); it's stated here so a
// future edit doesn't add one without noticing what it would open up:
// anyone signed in enumerating every household's data, not only the one
// they were handed a link to.
//
// `isValidProfileDoc` is a shallow shape check, a second, weaker copy
// of persistence.ts's own `hasCoreEngineShape`/`migrate` validation, not
// a replacement for it. Its job is only to reject obviously-wrong junk
// (an empty object, a string, a document missing the fields every real
// save has) so a scripted abuser can't cheaply fill the project with
// garbage documents; the client's own migrate() is still what decides
// whether a document is actually usable.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidProfileDoc(data) {
      return data.keys().hasAll(['version', 'updatedAt', 'activeRange', 'fact', 'fluency', 'boosted', 'streak'])
        && data.version is int
        && data.updatedAt is timestamp
        && data.activeRange.size is int
        && data.fact.a is int && data.fact.b is int
        && data.fluency is map
        && data.boosted is map
        && data.streak.count is int;
    }

    match /profiles/{profileId} {
      allow get: if isSignedIn();
      allow create, update: if isSignedIn() && isValidProfileDoc(request.resource.data);
      allow delete: if false;
      // No `allow list`; see the file comment above.
    }
  }
}
