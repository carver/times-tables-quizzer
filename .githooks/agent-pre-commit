#!/bin/sh
# What CI runs, on what's staged: unit tests, the e2e suite, then the
# pre-commit hook's type check. The pre-commit hook runs it first when
# $AI_AGENT is set (llm-toolbox's agent-commit-gate); run it by hand too.
set -e
# So the pre-commit hook does not run this script again.
export AGENT_PRE_COMMIT=1
hooks=$(cd "$(dirname "$0")" && pwd)
. "$hooks/snapshot.sh"
npm run -s test
# A failed run would otherwise park on the HTML report's server.
PLAYWRIGHT_HTML_OPEN=never npm run -s test:e2e
cd "$repo"
"$hooks/pre-commit"
