{
  "name": "times-tables-quizzer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.sw.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,auth \"vitest run --config firestore-tests/vitest.config.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:rules && npm run test:e2e"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "firebase-tools": "^15.26.0",
    "jsqr": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.0",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "qrcode-generator": "^2.0.4"
  }
}
